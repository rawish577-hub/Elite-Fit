{
  "expo": {
    "name": "Elite-Fit",
    "slug": "Elite-Fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "react-native-mediapipe-posedetection",
        {
          "assetsPaths": [
            "./app/assets/models/"
          ]
        }
      ]
    ]
  }
}